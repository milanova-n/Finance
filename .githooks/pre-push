#!/bin/sh
# Block git push when gitleaks finds secrets in the repository.

set -e

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

if ! command -v gitleaks >/dev/null 2>&1; then
  printf '\n'
  printf 'Push blocked: gitleaks is not installed (required for secret scanning).\n'
  printf '\n'
  printf 'Install:\n'
  printf '  Windows: winget install Gitleaks.Gitleaks\n'
  printf '  macOS:   brew install gitleaks\n'
  printf '  Linux:   https://github.com/gitleaks/gitleaks#installing\n'
  printf '\n'
  exit 1
fi

printf 'Running gitleaks on the full repository...\n'

CONFIG_ARG=""
if [ -f "$ROOT/.gitleaks.toml" ]; then
  CONFIG_ARG="--config $ROOT/.gitleaks.toml"
fi

# shellcheck disable=SC2086
if ! gitleaks detect --source "$ROOT" --no-banner $CONFIG_ARG; then
  printf '\n'
  printf 'Push blocked: gitleaks reported possible secrets in this repository.\n'
  printf 'Remove or rotate the credentials, commit the fix, then push again.\n'
  printf 'For intentional false positives, add an allowlist entry in .gitleaks.toml\n'
  printf '\n'
  exit 1
fi

printf 'gitleaks: no leaks found — push allowed.\n'
exit 0