{
  "name": "verdant",
  "version": "1.0.0",
  "private": true,
  "description": "Verdant — personal finance tracker. Tooling root; the app lives in web/ and server/.",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
