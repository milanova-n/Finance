{
  "name": "myfi",
  "version": "1.0.0",
  "private": true,
  "description": "MyFi — personal finance tracker. Tooling root; the app lives in web/ and server/.",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "gitleaks": "gitleaks git --no-banner --verbose --config .gitleaks.toml"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.9",
    "typescript-eslint": "^8.74.0"
  }
}
